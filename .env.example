# Exemple de configuration par variables d'environnement.
# Copiez ce fichier en « .env » (ignoré par git). scripts/run_local.sh le charge automatiquement ;
# sous Windows, définissez les variables dans la session PowerShell ($env:NOM = "valeur").
#
# Règle : PARTITION_<SECTION>__<CLÉ> surcharge config/default.yaml (double tiret bas entre niveaux).
# Aucun secret n'est nécessaire : tout tourne en local.

# --- Général ---
# PARTITION_ENGINE=bytedance                 # bytedance | mt3 | basic_pitch
# PARTITION_CONFIG=config/local.yaml         # YAML supplémentaire fusionné par-dessus default.yaml
# PARTITION_ROOT=/chemin/vers/le/depot       # racine du projet (détectée automatiquement sinon)

# --- Audio ---
# PARTITION_AUDIO__SAMPLE_RATE=22050
# PARTITION_AUDIO__MAX_DURATION_S=600
# PARTITION_AUDIO__NORMALIZE=true

# --- Nettoyage ---
# PARTITION_CLEANUP__MIN_DURATION_S=0.03
# PARTITION_CLEANUP__MIN_VELOCITY=12
# PARTITION_CLEANUP__MERGE_WINDOW_S=0.05

# --- Tempo et quantification ---
# PARTITION_TEMPO__METHOD=audio              # audio | midi
# PARTITION_TEMPO__FORCED_BPM=96
# PARTITION_TEMPO__FOLLOW_BEATS=true
# PARTITION_QUANTIZE__GRID=16                # 4, 8, 16 ou 32
# PARTITION_QUANTIZE__TRIPLETS=false

# --- Mains, tonalité, métrique ---
# PARTITION_HANDS__METHOD=threshold          # threshold | chord
# PARTITION_HANDS__SPLIT_PITCH=60
# PARTITION_NOTATION__KEY=a minor            # vide ou null = détection
# PARTITION_NOTATION__TIME_SIGNATURE=3/4
# PARTITION_NOTATION__TITLE=Mon morceau
# PARTITION_NOTATION__COMPOSER=
# PARTITION_NOTATION__AUTHOR=                # auteur de la transcription (métadonnées MusicXML et PDF)

# --- Chemins ---
# PARTITION_PATHS__MODELS_DIR=models
# PARTITION_PATHS__DATA_DIR=data
# MUSESCORE_PATH=C:\Program Files\MuseScore 4\bin\MuseScore4.exe
# LILYPOND_PATH=/usr/bin/lilypond
# FFMPEG_PATH=/usr/bin/ffmpeg

# --- Moteurs ---
# PARTITION_ENGINES__BYTEDANCE__DEVICE=cuda  # cpu | cuda
# PARTITION_ENGINES__MT3__MODEL_TYPE=mt3     # mt3 | ismir2021
# PARTITION_ENGINES__BASIC_PITCH__ONSET_THRESHOLD=0.5

# --- Serveur ---
# PARTITION_SERVER__HOST=127.0.0.1
# PARTITION_SERVER__PORT=8000
# PARTITION_SERVER__MAX_UPLOAD_MB=100
